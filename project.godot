; Godot Engine project configuration.
config_version=5

[application]

config/name="LIMINAL 天空车站"
run/main_scene="res://station.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/reference/compass.png"
boot_splash/image.web="res://assets/reference/compass.png"
boot_splash/bg_color.web=Color(0.065, 0.104, 0.17, 1)
boot_splash/stretch_mode.web=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
mesh_lod/lod_change/threshold_pixels.web=3.0
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/positional_shadow/atlas_size.web=1024
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=2048
textures/default_filters/anisotropic_filtering_level=4

[physics]

3d/default_gravity=16.0
